#: apps/web/src/board-port/whm-nginx-proxy-workspace.ts apps/web/src/themes/v2/pages/xwhm/service-tools/nginx-proxy.ts
msgid "Use / for the whole domain. The target receives the request path unchanged."
msgstr "استخدم / للنطاق كله. يستقبل الهدف مسار الطلب دون تغيير."

#: apps/web/src/whm-db-services-client.ts
msgid "Use 12 to 128 letters, digits or symbols, without spaces, quotes or backslashes."
msgstr "استخدم من 12 إلى 128 حرفًا أو رقمًا أو رمزًا، دون مسافات أو علامات اقتباس أو شرطات مائلة عكسية."

#: apps/web/src/board-port/mailx-whm-workspace.ts apps/web/src/themes/v2/pages/xwhm/mail/policy.ts
msgid "Use 587, 25 or 2525. Port 465 (implicit TLS) is not supported for a relay."
msgstr "استخدم 587 أو 25 أو 2525. المنفذ 465 (TLS الضمني) غير مدعوم لخادم الترحيل."

#: apps/web/src/whm-db-root-password-client.ts
msgid "Use 8 to 128 printable characters without spaces."
msgstr "استخدم من 8 إلى 128 محرفاً قابلاً للطباعة دون مسافات."

#: apps/web/src/board-port/db-engines-workspace.ts
msgid "Use 8 to 256 printable ASCII characters. xPanel keeps only a SCRAM-SHA-256 verifier, never the password."
msgstr "استخدم من 8 إلى 256 حرفاً من أحرف ASCII القابلة للطباعة. يحتفظ xPanel بمُحقِّق SCRAM-SHA-256 فقط ولا يحتفظ بكلمة المرور أبداً."

#: apps/web/src/board-port/xmail-calendar.ts apps/web/src/themes/v2/pages/xmail/workspaces/organizer.ts
msgid "Use ASCII YYYYMMDD for all-day dates, or YYYYMMDDTHHMMSS with Z for UTC. The end may not precede the start. Recurrence, attendees and alarms are outside this editor."
msgstr "استخدم YYYYMMDD بأرقام ASCII لتواريخ اليوم الكامل، أو YYYYMMDDTHHMMSS مع Z لتوقيت UTC. لا يجوز أن تسبق النهاية البداية. التكرار والمشاركون والتنبيهات خارج هذا المحرر."

#: apps/web/src/board-port/xmail-calendar-view.ts apps/web/src/themes/v2/pages/xmail/workspaces/organizer.ts
msgid "Use ASCII digits: dates as YYYY-MM-DD and 24-hour times as HH:MM. Times are ignored for all-day events. Saving checks the calendar version that was read; a newer version is never overwritten."
msgstr "استخدم أرقام ASCII: التواريخ بصيغة YYYY-MM-DD والأوقات بنظام 24 ساعة بصيغة HH:MM. تُهمل الأوقات في أحداث اليوم الكامل. يتحقق الحفظ من نسخة التقويم المقروءة؛ ولا تُستبدل نسخة أحدث أبدًا."

#: apps/web/src/board-port/xmail-contacts.ts apps/web/src/themes/v2/pages/xmail/workspaces/organizer.ts
msgid "Use Groups and membership below to manage owned contacts. Shared contacts remain read-only here. Saving updates the address book your devices sync; it does not send mail."
msgstr "أدر الجهات المملوكة من قسم المجموعات والعضوية أدناه. تبقى الجهات المشتركة للقراءة فقط هنا. يحدّث الحفظ دفتر العناوين الذي تزامنه أجهزتك؛ ولا يرسل بريدًا."

#: apps/web/src/whm-db-services-client.ts
msgid "Use IP addresses separated by commas."
msgstr "استخدم عناوين IP مفصولة بفواصل."

#: apps/web/src/board-port/sec-workspace.ts apps/web/src/themes/v2/pages/xwhm/security/policies.ts
msgid "Use ModSecurity with the OWASP Core Rule Set when the Nginx connector is installed"
msgstr "استخدام ModSecurity مع مجموعة قواعد OWASP الأساسية عند تثبيت موصّل Nginx"

#: apps/web/src/board-port/whm-monitoring-alerts-workspace.ts apps/web/src/themes/v2/pages/xwhm/monitoring/workflows.ts
msgid "Use a daily quiet window"
msgstr "استخدام نافذة هدوء يومية"

#: apps/web/src/account-web-directives-client.ts
msgid "Use a full host name, for example example.com."
msgstr "استخدم اسم مضيف كاملًا، مثل example.com."

#: apps/web/src/account-web-directives-client.ts
msgid "Use a full http or https address without quotes, spaces or parentheses."
msgstr "استخدم عنوان http أو https كاملًا دون علامات اقتباس أو مسافات أو أقواس."

#: apps/web/src/whm-db-services-client.ts
msgid "Use a lowercase name. admin, local and config are reserved."
msgstr "استخدم اسمًا بأحرف صغيرة. الأسماء admin وlocal وconfig محجوزة."

#: apps/web/src/account-pgp-client.ts
msgid "Use a name, a current mailbox, 1–3650 days and a passphrase of at least 12 characters."
msgstr "استخدم اسمًا وعنوان بريد حاليًا ومدة 1–3650 يومًا وعبارة مرور من 12 حرفًا على الأقل."

#: apps/web/src/file-workspace-client.ts
msgid "Use a path inside your home, outside the item itself, and a complete, unencrypted zip, tar, tar.gz, tar.bz2, tar.zst, gz, bz2 or zst file. Nothing was changed."
msgstr "استخدم مساراً داخل مجلدك الرئيسي وخارج العنصر نفسه، وملف zip أو tar أو tar.gz أو tar.bz2 أو tar.zst أو gz أو bz2 أو zst مكتملاً وغير مشفر. لم يتغير شيء."

#: apps/web/src/account-web-directives-client.ts
msgid "Use a path that starts with / without spaces, quotes, .. segments or a query string."
msgstr "استخدم مسارًا يبدأ بـ / دون مسافات أو علامات اقتباس أو مقاطع .. أو سلسلة استعلام."

msgid "Use a recovery code"
msgstr "استخدام رمز استرجاع"

#: apps/web/src/login-client.ts apps/web/src/surfaces/login.ts apps/web/src/themes/v2/surfaces/login.ts
msgctxt "login"
msgid "Use a recovery code"
msgstr "استخدم رمز استرداد"

#: apps/web/src/board-port/extensions/account-domains.ts apps/web/src/themes/v2/pages/xpanel/domains/domains.ts
msgid "Use a relative directory or an absolute path inside your home. Leave blank for the server default. This does not move files."
msgstr "استخدم مجلدًا نسبيًا أو مسارًا مطلقًا داخل مجلد الحساب. اتركه فارغًا لاستخدام اختيار الخادم. هذا لا ينقل الملفات."

#: apps/web/src/mail-spam-client.ts
msgid "Use a score from 0 through 100, a deletion score from 1 through 50, and unique sender addresses without overlap."
msgstr "استخدم درجة من 0 إلى 100، ودرجة حذف من 1 إلى 50، وعناوين مرسلين فريدة دون تداخل."

#: apps/web/src/surfaces/login-layout.ts apps/web/src/themes/v2/surfaces/login.ts
msgid "Use a server administrator or reseller account for this page."
msgstr "استخدم حساب مسؤول الخادم أو حساب موزّع لهذه الصفحة."

#: apps/web/src/whm-db-services-client.ts
msgid "Use a size such as 128MB."
msgstr "استخدم حجمًا مثل 128MB."

#: apps/web/src/models/dav-client-guide.ts
msgid "Use a third-party sync add-in and give it the direct calendar and address book URLs."
msgstr "استخدم إضافة مزامنة من طرف ثالث وزوّدها بالرابطين المباشرين للتقويم ودفتر العناوين."

#: apps/web/src/account-edge-client.ts
msgid "Use an IPv4 or IPv6 address, a range such as 10.5.3.3-40, a CIDR block such as 192.0.2.0/24, a prefix such as 10. or a host name."
msgstr "استخدم عنوان IPv4 أو IPv6، أو نطاقًا مثل 10.5.3.3-40، أو كتلة CIDR مثل 192.0.2.0/24، أو بادئة مثل 10.، أو اسم مضيف."

#: apps/web/src/board-port/whm-domains-workspace.ts apps/web/src/themes/v2/pages/xwhm/domains/index.ts
msgid "Use an account-relative folder or an absolute path inside its home. Changing this setting does not move files. Aliases inherit the parent folder."
msgstr "استخدم مجلدًا نسبيًا للحساب أو مسارًا مطلقًا داخل مجلده. لا ينقل هذا التغيير الملفات. ترث الأسماء البديلة مجلد النطاق الأب."

#: apps/web/src/board-port/xmail-mailbox-preferences.ts apps/web/src/themes/v2/pages/xmail/workspaces/settings.ts
msgid "Use an address outside this server. A problem here would also stop notices sent here."
msgstr "استخدم عنوانًا خارج هذا الخادم. أي عطل هنا سيوقف التنبيهات المرسلة إليه أيضًا."

#: apps/web/src/login-client.ts
msgid "Use an authenticator code"
msgstr "استخدم رمز تطبيق المصادقة"

#: apps/web/src/board-port/account-database-remote-workspace.ts
msgid "Use an exact IPv4 or IPv6 address, or an IPv4 CIDR with zero host bits. A range such as 192.0.2.% is saved as 192.0.2.0/24. DNS names, any-host %, /0 and IPv6 subnets are refused."
msgstr "استخدم عنوان IPv4 أو IPv6 محددًا، أو CIDR لشبكة IPv4 دون بتات مضيف. يُحفظ نطاق مثل 192.0.2.% بصيغة 192.0.2.0/24. تُرفض أسماء DNS و% لأي مضيف و/0 وشبكات IPv6 الفرعية."

#: apps/web/src/board-port/approved-xpanel-pages.ts
msgid "Use an existing certificate"
msgstr "استخدام شهادة موجودة"

msgid "Use an http, https or mailto link without embedded credentials."
msgstr "استخدم رابط http أو https أو mailto دون بيانات دخول مضمنة."

#: apps/web/src/file-workspace-client.ts
msgid "Use an octal mode within the allowed ceiling (0640 file / 0750 folder); no change was made."
msgstr "استخدم نمطًا ثمانيًا ضمن الحد المسموح (0640 للملف / 0750 للمجلد)؛ لم يُجرَ أي تغيير."

#: apps/web/src/mail-cards.ts
msgid "Use as"
msgstr "استخدام كـ"

#: apps/web/src/board-port/xmail-identities.ts apps/web/src/themes/v2/pages/xmail/workspaces/settings.ts
msgid "Use as default"
msgstr "استخدام كافتراضي"

#: apps/web/src/team-password.ts
msgid "Use at least 8 characters on one line."
msgstr "استخدم 8 أحرف على الأقل في سطر واحد."

#: apps/web/src/account-owner-tools-client.ts
msgid "Use at least two letters, digits or module name characters."
msgstr "استخدم محرفين على الأقل من الحروف أو الأرقام أو رموز أسماء الوحدات."

#: apps/web/src/board-port/whm-db-tools-workspace.ts apps/web/src/themes/v2/pages/xwhm/databases/index.ts
msgid "Use exact IP addresses or an IPv4 network. An account owner can remove a pushed host from the account; the next push adds it again."
msgstr "استخدم عناوين IP دقيقة أو شبكة IPv4. يمكن لمالك الحساب إزالة مضيف مدفوع من حسابه، ويضيفه الدفع التالي مجددًا."

#: apps/web/src/whm-db-tools-client.ts
msgid "Use exact IP addresses or an IPv4 network. Names and any-host entries are refused."
msgstr "استخدم عناوين IP دقيقة أو شبكة IPv4. تُرفض الأسماء والإدخالات التي تسمح بأي مضيف."

#: apps/web/src/board-port/whm-benchmark-workspace.ts apps/web/src/themes/v2/pages/xwhm/monitoring/workflows.ts
msgid "Use host jobs to follow progress or request cancellation between steps. A sudden agent or machine stop can leave a temporary file requiring review."
msgstr "استخدم مهام المضيف لمتابعة التقدم أو طلب الإلغاء بين الخطوات. قد يترك توقف الوكيل أو الجهاز المفاجئ ملفًا مؤقتًا يحتاج إلى مراجعة."

#: apps/web/src/whm-nginx-proxy-client.ts
msgid "Use http:// or https://, a host and an optional port, without a path."
msgstr "استخدم http:// أو https:// ثم المضيف ومنفذًا اختياريًا، دون مسار."

#: apps/web/src/account-web-directives-client.ts
msgid "Use letters and digits only, for example .md."
msgstr "استخدم الأحرف والأرقام فقط، مثل .md."

#: apps/web/src/service-users-client.ts
msgid "Use letters, digits, dots, dashes and underscores in the username."
msgstr "استخدم الحروف والأرقام والنقاط والشرطات والشرطات السفلية في اسم المستخدم."

#: apps/web/src/ssl-store-client.ts
msgid "Use letters, digits, spaces and . , ' & ( ) _ - in the name, up to 64 characters."
msgstr "استخدم في الاسم الحروف والأرقام والمسافات و . , ' & ( ) _ - فقط، حتى 64 حرفًا."

#: apps/web/src/ssl-store-client.ts
msgid "Use letters, digits, spaces and . , ' & ( ) _ @ - in the subject fields, and a two-letter country code."
msgstr "استخدم في حقول الموضوع الحروف والأرقام والمسافات و . , ' & ( ) _ @ - فقط، ورمز دولة من حرفين."

#: apps/web/src/board-port/account-dynamic-dns-workspace.ts apps/web/src/themes/v2/pages/xpanel/domains/dynamic-dns.ts
msgid "Use lowercase DNS names. Existing single address records keep their TTL; new records use 300 seconds. The first update creates or changes the address record. At most 25 credentials per account."
msgstr "استخدم أسماء DNS بأحرف صغيرة. تحتفظ سجلات العناوين المفردة الحالية بمدة TTL؛ تستخدم السجلات الجديدة 300 ثانية. ينشئ التحديث الأول سجل العنوان أو يغيّره. الحد الأقصى 25 اعتمادًا لكل حساب."

#: apps/web/src/whm-db-tools-client.ts
msgid "Use lowercase letters, digits and underscores only."
msgstr "استخدم أحرفًا صغيرة وأرقامًا وشرطات سفلية فقط."

#: apps/web/src/mail-cards-client.ts
msgid "Use one name = value per line, each name once. Nothing was saved."
msgstr "استخدم name = value واحدًا في كل سطر، وكل اسم مرة واحدة. لم يُحفظ شيء."

#: apps/web/src/board-port/account-reverse-proxy-workspace.ts apps/web/src/themes/v2/pages/xpanel/domains/reverse-proxy.ts
msgid "Use port 1024 or higher. Ports used by server services or by another account are refused. A remote address works only when the server administrator allowed its host."
msgstr "استخدم المنفذ 1024 أو أعلى. تُرفض المنافذ التي تستخدمها خدمات الخادم أو حساب آخر. لا يعمل العنوان البعيد إلا إذا سمح مسؤول الخادم بمضيفه."

#: apps/web/src/board-port/approved-xpanel-pages.ts
msgid "Use server default"
msgstr "استخدام افتراضي السيرفر"

#: apps/web/src/board-port/account-logs-workspace.ts apps/web/src/themes/v2/pages/xpanel/observations/logs.ts
msgid "Use server defaults"
msgstr "استخدام الإعدادات الافتراضية للخادم"

#: apps/web/src/board-canvas.ts apps/web/src/board-port/approved-xwhm.ts
msgid "Use suggested values"
msgstr "استخدام القيم المقترحة"

#: apps/web/src/surfaces/login.ts apps/web/src/themes/v2/surfaces/login.ts
msgid "Use the 6-digit code from the authenticator linked to this account."
msgstr "استخدم الرمز المكوّن من 6 أرقام من تطبيق المصادقة المرتبط بهذا الحساب."

#: apps/web/src/board-canvas.ts
msgid "Use the CA renewal window (ARI)"
msgstr "استخدام نافذة التجديد لدى جهة الإصدار (ARI)"

#: apps/web/src/board-port/approved-xwhm.ts apps/web/src/themes/v2/pages/xwhm/server/setup.ts
