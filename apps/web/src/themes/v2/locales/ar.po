msgctxt "theme:v2"
msgid "Added line:"
msgstr "سطر مضاف:"

msgctxt "theme:v2"
msgid "All in group"
msgstr "الكل في المجموعة"

msgctxt "theme:v2"
msgid "Applies as generation {next}; generation {current} stays as the rollback target"
msgstr "يُطبَّق بوصفه الجيل «{next}»، ويبقى الجيل «{current}» هدف التراجع"

msgctxt "theme:v2"
msgid "Apply changes"
msgstr "تطبيق التغييرات"

msgctxt "theme:v2"
msgid "Back to editing"
msgstr "العودة إلى التحرير"

msgctxt "theme:v2"
msgid "Before the switch"
msgstr "قبل التبديل"

msgctxt "theme:v2"
msgid "Bulk actions"
msgstr "الإجراءات الجماعية"

msgctxt "theme:v2"
msgid "Copy {name}"
msgstr "نسخ {name}"

msgctxt "theme:v2"
msgid "Follow"
msgstr "متابعة"

msgctxt "theme:v2"
msgid "Following"
msgstr "قيد المتابعة"

msgctxt "theme:v2"
msgid "Generation {generation} stays on disk as the rollback target. If a test fails, generation {generation} stays live and nothing is reloaded."
msgstr "يبقى الجيل «{generation}» على القرص هدف التراجع. إذا فشل اختبار يبقى الجيل «{generation}» فعّالًا ولا يُعاد تحميل أي شيء."

msgctxt "theme:v2"
msgid "Jobs, configuration generations and audit entries appear here as they happen."
msgstr "تظهر هنا المهام وأجيال الإعدادات وسجلات التدقيق فور حدوثها."

msgctxt "theme:v2"
msgid "Legend"
msgstr "مفتاح الرموز"

msgctxt "theme:v2"
msgid "Measured value"
msgstr "القيمة المقيسة"

msgctxt "theme:v2"
msgid "Not following. The entries below are from one read."
msgstr "المتابعة متوقفة. الإدخالات أدناه من قراءة واحدة."

msgctxt "theme:v2"
msgid "Nothing to show yet."
msgstr "لا يوجد ما يُعرض بعد."

msgctxt "theme:v2"
msgid "Pagination"
msgstr "التنقل بين الصفحات"

msgctxt "theme:v2"
msgid "Problem tick"
msgstr "علامة المشكلة"

msgctxt "theme:v2"
msgid "Reconcile pipeline"
msgstr "مسار المطابقة"

msgctxt "theme:v2"
msgid "Removed line:"
msgstr "سطر محذوف:"

msgctxt "theme:v2"
msgid "Review and apply"
msgstr "مراجعة وتطبيق"

msgctxt "theme:v2"
msgid "Review and save"
msgstr "مراجعة وحفظ"

msgctxt "theme:v2"
msgid "Rows"
msgstr "الصفوف"

msgctxt "theme:v2"
msgid "Save is available after the draft passes its test."
msgstr "يتاح الحفظ بعد أن تجتاز المسودة اختبارها."

msgctxt "theme:v2"
msgid "Saved with a revision check: if the stored settings changed after this page read them, nothing is overwritten."
msgstr "يُحفظ مع التحقق من المراجعة: إذا تغيّرت الإعدادات المخزّنة بعد أن قرأتها هذه الصفحة فلن يُستبدل أي شيء."

msgctxt "theme:v2"
msgid "Search accounts and settings"
msgstr "ابحث في الحسابات والإعدادات"

msgctxt "theme:v2"
msgid "Step {current} of {total}"
msgstr "الخطوة {current} من {total}"

msgctxt "theme:v2"
msgid "Test before the switch"
msgstr "الاختبار قبل التبديل"

msgctxt "theme:v2"
msgid "Tests run before the switch"
msgstr "اختبارات تعمل قبل التبديل"

msgctxt "theme:v2"
msgid "The draft passed its test. Saving writes exactly the tested draft."
msgstr "اجتازت المسودة اختبارها. يكتب الحفظ المسودة المختبرة نفسها تمامًا."

msgctxt "theme:v2"
msgid "This list could not be read."
msgstr "تعذّرت قراءة هذه القائمة."

msgctxt "theme:v2"
msgid "This page could not be read."
msgstr "تعذّرت قراءة هذه الصفحة."

msgctxt "theme:v2"
msgid "Undo the change to {field}"
msgstr "التراجع عن تغيير {field}"

msgctxt "theme:v2"
msgid "Warning tick"
msgstr "علامة التحذير"

msgctxt "theme:v2"
msgid "gen {generation}"
msgstr "الجيل «{generation}»"

