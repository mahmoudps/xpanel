msgid "{count, plural, =0 {Notifications, none unread} one {Notifications, # unread} other {Notifications, # unread}}"
msgstr "{count, plural, =0 {الإشعارات، لا شيء غير مقروء} one {الإشعارات، واحد غير مقروء} two {الإشعارات، اثنان غير مقروءين} few {الإشعارات، # غير مقروءة} many {الإشعارات، # غير مقروء} other {الإشعارات، # غير مقروء}}"

msgctxt "theme:v2"
msgid "{count, plural, one {# pending change} other {# pending changes}}"
msgstr "{count, plural, zero {لا تغييرات معلّقة} one {تغيير معلّق واحد} two {تغييران معلّقان} few {# تغييرات معلّقة} many {# تغييرًا معلّقًا} other {# تغيير معلّق}}"
