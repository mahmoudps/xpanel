{
  "name": "xpanel",
  "private": true,
  "description": "Open-source web hosting control panel with per-account isolation, configuration files as the source of truth and a small footprint.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahmoudps/xpanel.git"
  },
  "homepage": "https://github.com/mahmoudps/xpanel#readme",
  "bugs": {
    "url": "https://github.com/mahmoudps/xpanel/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "start": "node apps/api/src/main.ts",
    "start:agent": "node apps/agent/src/main.ts",
    "cli": "node apps/api/src/main.ts xpanel",
    "test": "node scripts/test-suite.mjs portable",
    "test:unit": "node scripts/test-suite.mjs unit",
    "test:http": "node scripts/test-suite.mjs http",
    "test:linux": "node scripts/test-suite.mjs linux",
    "test:browser": "node scripts/test-suite.mjs browser",
    "test:all": "node scripts/test-suite.mjs all",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "catalog:",
    "@types/ws": "8.18.2",
    "axe-core": "4.14.0",
    "es-module-lexer": "3.0.4",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
